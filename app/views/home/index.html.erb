<div class="row">
  <div class="col-md-8 mx-auto">
    <div class="card">
      <div class="card-body text-center py-5">
        <h1 class="display-4 mb-4">User Management System</h1>
        <p class="lead mb-4">Welcome to the User Management System. Please sign in or register to continue.</p>
        <div class="d-flex gap-3 justify-content-center">
          <%= link_to 'Sign In', new_user_session_path, class: 'btn btn-primary btn-lg' %>
          <%= link_to 'Sign Up', new_user_registration_path, class: 'btn btn-outline-primary btn-lg' %>
        </div>
      </div>
    </div>
  </div>
</div>

